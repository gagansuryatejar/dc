# ──────────────────────────────────────────────────────────────────────
# NEXUS AI — Environment Configuration (Production Stack)
# Copy this file to .env and fill in the required values.
# Never commit .env to version control.
# ──────────────────────────────────────────────────────────────────────

# ── Discord Credentials (REQUIRED) ────────────────────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID — found on the OAuth2 / General page
DISCORD_CLIENT_ID=

# Application secret — needed for OAuth2 dashboard flows (Phase 11)
DISCORD_CLIENT_SECRET=

# Discord public key — used to verify interaction signatures (Phase 11)
DISCORD_PUBLIC_KEY=

# Bot owner Discord user ID (bypass checks, emergency commands)
OWNER_ID=

# Development guild ID — slash commands registered here instantly during dev
GUILD_ID=

# ── Database (PostgreSQL, REQUIRED) ────────────────────────────────────
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?schema=public
# Example (local Docker): postgresql://nexus:nexus_password@localhost:5432/nexus_ai
DATABASE_URL=

# ── Redis Cache / Queue (REQUIRED for production) ──────────────────────
# Format: redis://[:PASSWORD]@HOST:PORT
# Example (local Docker): redis://:nexus_redis_password@localhost:6379
REDIS_URL=

# ── Logging ────────────────────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Environment ────────────────────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ── AI Provider Configuration ──────────────────────────────────────────
# Which AI backend to use: gemini | openai | ollama
AI_PROVIDER=gemini

# Google Gemini API key (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama server URL (required when AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# ── Backend API Service ────────────────────────────────────────────────
API_PORT=4000
API_HOST=0.0.0.0

# ── Dashboard (Next.js, Phase 11) ──────────────────────────────────────
DASHBOARD_PORT=3000
DASHBOARD_SECRET=

# ── Deployment ─────────────────────────────────────────────────────────
# Deployment target: server (Linux VPS / cloud)
DEPLOYMENT_MODE=server

# ── Security ───────────────────────────────────────────────────────────
# JWT signing secret for dashboard authentication (Phase 11)
JWT_SECRET=

# Encryption key for sensitive at-rest data (32 base64 chars recommended)
ENCRYPTION_KEY=
