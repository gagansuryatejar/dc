# ──────────────────────────────────────────────────────────
# NEXUS AI — Environment Configuration
# Copy this file to .env and fill in the values.
# ──────────────────────────────────────────────────────────

# ── Discord Credentials (REQUIRED) ───────────────────────
# Bot token from https://discord.com/developers/applications
DISCORD_TOKEN=

# Application (client) ID — found on the OAuth2 page
DISCORD_CLIENT_ID=

# Application secret — needed for OAuth2 dashboard flows
DISCORD_CLIENT_SECRET=

# Development guild ID — commands are registered here instantly during dev
GUILD_ID=

# ── Database ─────────────────────────────────────────────
# SQLite connection string (relative to project root)
DATABASE_URL=file:./data/nexus.db

# ── Logging ──────────────────────────────────────────────
# Pino log level: trace | debug | info | warn | error | fatal
LOG_LEVEL=info

# ── Environment ──────────────────────────────────────────
# development | production | test
NODE_ENV=development

# ── AI Provider Configuration ────────────────────────────
# Which AI backend to use: gemini | openai | ollama
AI_PROVIDER=gemini

# Google Gemini API key (required when AI_PROVIDER=gemini)
GEMINI_API_KEY=

# OpenAI API key (required when AI_PROVIDER=openai)
OPENAI_API_KEY=

# Ollama server URL (required when AI_PROVIDER=ollama)
OLLAMA_URL=http://localhost:11434

# ── Dashboard ────────────────────────────────────────────
# Port for the web dashboard
DASHBOARD_PORT=3000

# Secret key for signing dashboard sessions / JWT tokens
DASHBOARD_SECRET=

# ── Deployment ───────────────────────────────────────────
# Deployment target: android | server
# "android" disables features that need native deps (e.g. voice)
DEPLOYMENT_MODE=server
