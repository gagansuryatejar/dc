# ─────────────────────────────────────────────────────────
# NEXUS AI — .gitignore
# ─────────────────────────────────────────────────────────

# Environment & secrets
.env
.env.local
.env.*.local
*.key
*.pem

# Dependencies
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# TypeScript / build output
dist/
build/
*.tsbuildinfo
next/dist/

# Prisma
prisma/migrations/*.sql

# Logs
logs/
*.log

# IDE
.vscode/
.idea/
*.swp
*.swo
.DS_Store

# Data & backups
data/
backups/
*.db
*.sqlite
*.sqlite3

# Docker
.docker/

# Coverage
coverage/
.nyc_output/

# Turbo / Next.js
.turbo/
