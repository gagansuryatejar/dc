{
  "name": "nexus-ai",
  "version": "1.0.0",
  "description": "NEXUS AI — Advanced Discord bot with modular architecture",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/index.js",
    "start:dashboard": "node dist/dashboard/server.js",
    "dev": "tsx watch src/index.ts",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "lint": "eslint src --ext .ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "test:all": "tsx tests/phase1.test.ts && tsx tests/phase2.test.ts && tsx tests/phase3.test.ts && tsx tests/phase4.test.ts && tsx tests/phase5.test.ts && tsx tests/phase6.test.ts && tsx tests/phase7.test.ts && tsx tests/phase8.test.ts && tsx tests/phase9.test.ts && tsx tests/phase10.test.ts && tsx tests/heart.test.ts"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "nexus"
  ],
  "license": "MIT",
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@noble/ciphers": "^2.4.0",
    "@prisma/client": "^6.0.0",
    "cron": "^3.1.9",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "ms": "^2.1.3",
    "opusscript": "^0.0.8",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^22.9.0",
    "prisma": "^6.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
