{
  "name": "nexus-ai",
  "version": "1.0.0",
  "description": "NEXUS AI — Enterprise-Grade Discord Community Operating System (PostgreSQL + Fastify + Next.js)",
  "main": "dist/src/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc && node scripts/copy-assets.js",
    "start": "node dist/src/index.js",
    "start:bot": "node dist/src/index.js",
    "start:api": "node dist/services/backend-api/src/index.js",
    "dev": "tsx watch src/index.ts",
    "dev:api": "tsx watch services/backend-api/src/index.ts",
    "deploy:commands": "tsx scripts/deploy-commands.ts",
    "lint": "eslint src services --ext .ts",
    "db:generate": "prisma generate",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate deploy",
    "db:studio": "prisma studio",
    "test": "tsx tests/phase1.test.ts",
    "test:all": "tsx tests/phase1.test.ts"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@discordjs/voice": "^0.18.0",
    "@fastify/cors": "^10.0.1",
    "@fastify/helmet": "^13.0.1",
    "@noble/ciphers": "^2.4.0",
    "@prisma/client": "^6.0.0",
    "discord-api-types": "^0.37.120",
    "discord.js": "^14.16.3",
    "dotenv": "^16.4.5",
    "fastify": "^5.0.0",
    "ms": "^2.1.3",
    "opusscript": "^0.0.8",
    "pino": "^9.5.0",
    "pino-pretty": "^13.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/ms": "^0.7.34",
    "@types/node": "^22.9.0",
    "prisma": "^6.0.0",
    "rimraf": "^6.0.1",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  },
  "keywords": [
    "discord",
    "bot",
    "ai",
    "nexus",
    "postgresql",
    "fastify"
  ],
  "license": "MIT"
}
