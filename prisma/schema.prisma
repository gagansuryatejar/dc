// ==================================================================
// NEXUS AI — Prisma Schema (PostgreSQL)
// Provider: postgresql
// ==================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────
// Core — Phase 1
// ─────────────────────────────────────────────────────────────────────

model Guild {
  id            String   @id        // Discord guild ID (snowflake)
  name          String
  ownerId       String
  locale        String   @default("en")
  timezone      String   @default("UTC")
  welcomeChannel String?
  logChannel    String?
  announcementChannel String?
  features      String   @default("{}") // JSON — per-guild feature flags
  settings      String   @default("{}") // JSON — per-guild settings
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  members             GuildMember[]
  moduleConfigs       ModuleConfig[]
  auditLogs           AuditLog[]
  suggestions         Suggestion[]
  polls               Poll[]
  infractions         Infraction[]
  tickets             SupportTicket[]

  @@index([ownerId])
}

model GuildMember {
  id           String   @id @default(cuid())
  guildId      String
  userId       String   // Discord user ID (snowflake)
  username     String
  displayName  String?
  timezone     String   @default("UTC")
  joinedAt     DateTime @default(now())
  lastActive   DateTime @default(now())
  xp           Int      @default(0)
  level        Int      @default(0)
  voiceMinutes Int      @default(0)
  messageCount Int      @default(0)
  coins        Int      @default(0)
  reputation   Int      @default(0)
  dailyStreak  Int      @default(0)
  lastDaily    DateTime?
  lastRepGiven DateTime?
  birthday     String?  // MM-DD format
  bio          String?
  badges       String   @default("[]")   // JSON array of badge IDs
  preferences  String   @default("{}")   // JSON — notification & interaction prefs
  consentFlags String   @default("{}")   // JSON — voice/data consent flags
  warnings     Int      @default(0)
  isMuted      Boolean  @default(false)
  isBanned     Boolean  @default(false)

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, userId])
  @@index([userId])
  @@index([guildId, xp])
  @@index([guildId, level])
  @@index([guildId, voiceMinutes])
  @@index([guildId, lastActive])
  @@index([guildId, reputation])
}

model ModuleConfig {
  id        String   @id @default(cuid())
  guildId   String
  module    String   // e.g. "voice", "ai", "moderation", "engagement"
  enabled   Boolean  @default(true)
  settings  String   @default("{}") // JSON — module-specific settings
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, module])
  @@index([guildId, enabled])
}

model AuditLog {
  id        String   @id @default(cuid())
  guildId   String
  userId    String?
  action    String
  target    String?
  details   String?    // JSON string
  module    String?
  severity  String   @default("info") // info | warn | error | critical
  createdAt DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, createdAt])
  @@index([guildId, action])
  @@index([guildId, userId])
  @@index([guildId, severity])
}

// ==================================================================
// Additional models reserved for later phases (placeholders, unused in Phase 1)
// These keep the schema forward-compatible and are created on db:push.
// ==================================================================

model Suggestion {
  id        String   @id @default(cuid())
  guildId   String
  userId    String
  username  String
  channelId String?
  messageId String?
  content   String
  status    String   @default("pending")
  guild     Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  votes     SuggestionVote[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([guildId, status])
  @@index([guildId, userId])
}

model SuggestionVote {
  id          String   @id @default(cuid())
  suggestionId String
  userId      String
  voteType    String   // "upvote" | "downvote"
  createdAt   DateTime @default(now())

  suggestion Suggestion @relation(fields: [suggestionId], references: [id], onDelete: Cascade)

  @@unique([suggestionId, userId])
  @@index([suggestionId])
  @@index([userId])
}

model Poll {
  id          String   @id @default(cuid())
  guildId     String
  creatorId   String
  channelId   String
  messageId   String?
  question    String
  options     String   // JSON array
  allowMultiple Boolean @default(false)
  expiresAt   DateTime?
  isActive    Boolean  @default(true)
  guild       Guild    @relation(fields: [guildId], references: [id], onDelete: Cascade)
  votes       PollVote[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([guildId, isActive])
  @@index([guildId, creatorId])
}

model PollVote {
  id         String   @id @default(cuid())
  pollId     String
  userId     String
  optionIndex Int
  createdAt  DateTime @default(now())

  poll Poll @relation(fields: [pollId], references: [id], onDelete: Cascade)

  @@unique([pollId, userId, optionIndex])
  @@index([pollId])
  @@index([userId])
}

model Infraction {
  id              String   @id @default(cuid())
  guildId         String
  userId          String
  moderatorId     String
  type            String   // warn | timeout | mute | kick | ban
  reason          String
  durationMinutes Int?
  expiresAt       DateTime?
  active          Boolean  @default(true)
  createdAt       DateTime @default(now())

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@index([guildId, userId])
  @@index([guildId, active])
}

model SupportTicket {
  id              String   @id @default(cuid())
  ticketNumber    Int
  guildId         String
  channelId       String?
  creatorId       String
  creatorUsername String
  subject         String
  category        String   @default("general")
  status          String   @default("open")
  closedBy        String?
  closedAt        DateTime?
  transcript      String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  guild Guild @relation(fields: [guildId], references: [id], onDelete: Cascade)

  @@unique([guildId, ticketNumber])
  @@index([guildId, status])
  @@index([guildId, creatorId])
}
